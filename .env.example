# 🤖 GEMINI STORE BOT — CONFIGURAÇÕES BÁSICAS
# ═══════════════════════════════════════════════════════════════════════════════
# Tudo pode ser configurado direto pelo chat do Telegram digitando /admin
# Apenas BOT_TOKEN e ADMIN_ID são obrigatórios aqui para ligar o bot.

# 1. Token do Bot criado no @BotFather do Telegram
BOT_TOKEN=123456789:ABCdefGHIjklMNOpqrsTUVwxyz

# 2. Seu ID de Usuário no Telegram (pegue no bot @userinfobot)
ADMIN_ID=987654321

# 3. URL da API Mestra do Fornecedor (mantenha o padrão se não souber)
API_BASE_URL=https://api.hewhotries.tech/v1

# 4. (Opcional) Configurações que podem ser inseridas direto pelo chat no /admin:
# MP_ACCESS_TOKEN=APP_USR-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# RESELLER_API_KEY=gg_live_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# SALE_PRICE_BRL=29.90
# STORE_NAME="Minha Loja VIP"
# SUPPORT_USERNAME=seu_usuario_telegram
